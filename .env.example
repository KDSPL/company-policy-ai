# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# ---- Database ----
# Host is `postgres` when the app runs in Docker/Coolify; use `localhost` when the app
# runs directly on your machine. The password MUST match POSTGRES_PASSWORD.
DATABASE_URL=postgresql://postgres:change_me@postgres:5432/company_policy_db?schema=public
POSTGRES_PASSWORD=change_me

# ---- Ollama ----
OLLAMA_BASE_URL=http://ollama:11434
CHAT_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text

# ---- Auth (Auth.js / NextAuth v5) ----
# Generate AUTH_SECRET with:  openssl rand -hex 32
AUTH_SECRET=replace_me
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000

# ---- SMTP (Gmail: use an App Password, not the account password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Admin allow-list (comma-separated) ----
ADMIN_EMAILS=admin@example.com
